<resources>
  <color name="splashscreen_background">#355E52</color>
  <color name="iconBackground">#FBF8F2</color>
  <color name="colorPrimary">#023c69</color>
  <color name="colorPrimaryDark">#355E52</color>

  <!-- ── ウィジェット カラートークン (Light) ─────────────────────────────────
       DS の primitive → semantic (light) の対応をここで宣言し、
       drawable / layout / Kotlin から @color/widget_* で参照する。
       システムが dark mode の場合は values-night/colors.xml が自動的に
       優先されるため、Kotlin 側は Configuration を意識しなくてよい。      -->

  <!-- surface.raised = ivory[50] — ウィジェット背景 (カード的な単体面) -->
  <color name="widget_surface_inverse">#FFFFFDF7</color>

  <!-- content.primary = stone[900] — メインテキスト -->
  <color name="widget_text_primary">#FF1C1C1A</color>

  <!-- content.secondary = stone[600] — サブテキスト -->
  <color name="widget_text_secondary">#FF6E776E</color>

  <!-- action.text.default (light 面) = sage[700] — アクセント / リング進捗 -->
  <color name="widget_accent">#FF54736C</color>

  <!-- action.primary.onContainer = sage[900] — 選択状態(container)上の文字。✓・取り消すに使用 -->
  <color name="widget_undo">#FF264F44</color>

  <!-- surface.sunken = ivory[300] — 非選択ボタンの地・リングのtrack -->
  <color name="widget_btn_surface">#FFE5E0D7</color>

  <!-- action.primary.container = sage[100] — 記録済みボタンの背景 -->
  <color name="widget_btn_logged">#FFE1EADD</color>

  <!-- border.subtle = ivory[500] — 4×2 のリング列とボタン列の間の線 -->
  <color name="widget_divider">#FFE2DCCF</color>
</resources>