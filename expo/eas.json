{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote",
    "promptToConfigurePushNotifications": false
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true,
        "image": "macos-tahoe-26.6-xcode-27.0"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "ios": {
        "simulator": false,
        "image": "macos-tahoe-26.6-xcode-27.0",
        "env": {
          "SENTRY_DISABLE_AUTO_UPLOAD": "true"
        }
      },
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_ALLOW_PAYWALL_SKIP": "true"
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "ios": {
        "image": "macos-tahoe-26.6-xcode-27.0",
        "env": {
          "SENTRY_DISABLE_AUTO_UPLOAD": "true"
        }
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6823520048",
        "appleTeamId": "JW8K44JXT4"
      },
      "android": {
        "serviceAccountKeyPath": "./google-play-service-account.json",
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  }
}
